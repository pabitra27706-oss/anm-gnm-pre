# ══════════════════════════════════════
# WB ANM GNM 2026 — .gitignore
# ══════════════════════════════════════

# ── Operating System ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Code Editors & IDEs ──
.vscode/
.vscode/settings.json
.vscode/extensions.json
.idea/
.idea/**
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Build Output (if using any build tool later) ──
dist/
build/
out/
.next/
.nuxt/

# ── Dependencies (if Node.js tools added later) ──
node_modules/
.npm
.yarn-integrity
package-lock.json
yarn.lock

# ── Environment Variables ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ── Temporary Files ──
temp/
tmp/
.temp/
.tmp/
*.tmp
*.temp
*.bak
*.backup

# ── Cache ──
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ── Testing ──
coverage/
.nyc_output/

# ── Misc ──
*.gz
*.zip
*.tar
*.rar
NOTES.md
TODO.md
SCRATCH.md